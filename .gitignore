# Publish only the editor source and website. Local device data stays private.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/README.en.md
!/index.html
!/src/
/src/*
!/src/README.md
!/src/build.py
!/src/page.html
!/src/style.css
!/src/core.js
!/src/upload.js
!/src/pad.js
!/src/app.js
!/src/upload-ui.js
!/src/pad-ui.js
!/src/batch.js
!/src/batch-ui.js
!/src/test-batch.cjs
!/src/i18n.js
!/src/test-i18n.cjs
!/src/backup.js
!/src/backup-ui.js
!/src/actions-ui.js
!/src/test-backup.cjs
!/src/locales/
/src/locales/*
!/src/locales/en.json
